// Stock xkb maps F17/F18/F20-F22 to XF86Launch8/9, XF86AudioMicMute and
// XF86Touchpad* keysyms, which games can't bind (and F20 mutes the mic).
// The G502's extra buttons send F17-F21, so give them plain F-key keysyms.
// F13-F16 are left alone: the Keychron's physical keys rely on them (F16 = dictation).
partial alphanumeric_keys
xkb_symbols "real" {
    key <FK17> { [ F17 ] };
    key <FK18> { [ F18 ] };
    key <FK19> { [ F19 ] };
    key <FK20> { [ F20 ] };
    key <FK21> { [ F21 ] };
    key <FK22> { [ F22 ] };
};
